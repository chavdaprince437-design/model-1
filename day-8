<!DOCTYPE html>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-50">
    
    <div>
        <h1 class="text-4xl font-bold mb-0 bg-blue-500 text-white p-4 w-full">Flex Box</h1>
    </div>

    <!-- Main Container with Nav and Table -->
    <div class="flex h-screen">
        <!-- Sidebar Navigation -->
        <nav class="w-64 bg-gray-900 text-white overflow-y-auto">
            <div class="p-6">
                <h2 class="text-2xl font-bold mb-8">Menu</h2>
                <ul class="space-y-4">
                    <li><a href="#" class="block px-4 py-2 rounded hover:bg-gray-700 transition">Dashboard</a></li>
                    <li><a href="#" class="block px-4 py-2 rounded hover:bg-gray-700 transition">Students</a></li>
                    <li><a href="#" class="block px-4 py-2 rounded hover:bg-gray-700 transition">Courses</a></li>
                    <li><a href="#" class="block px-4 py-2 rounded hover:bg-gray-700 transition">Reports</a></li>
                    <li><a href="#" class="block px-4 py-2 rounded hover:bg-gray-700 transition">Settings</a></li>
                </ul>
            </div>
        </nav>

        <!-- Main Content -->
        <div class="flex-1 p-8 overflow-y-auto">
            <h2 class="text-2xl font-bold text-gray-800 mb-6">Student Records</h2>
            
            <!-- Table -->
            <div class="bg-white rounded-lg shadow overflow-hidden">
                <table class="w-full">
                    <thead class="bg-blue-600 text-white">
                        <tr>
                            <th class="px-6 py-3 text-left font-semibold">ID</th>
                            <th class="px-6 py-3 text-left font-semibold">Name</th>
                            <th class="px-6 py-3 text-left font-semibold">Email</th>
                            <th class="px-6 py-3 text-left font-semibold">Course</th>
                            <th class="px-6 py-3 text-left font-semibold">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200">
                        <tr class="hover:bg-gray-50 transition">
                            <td class="px-6 py-4 text-gray-900">001</td>
                            <td class="px-6 py-4 text-gray-900">John Doe</td>
                            <td class="px-6 py-4 text-gray-600">john@example.com</td>
                            <td class="px-6 py-4 text-gray-600">Web Dev</td>
                            <td class="px-6 py-4"><span class="bg-green-100 text-green-800 px-3 py-1 rounded-full text-xs font-semibold">Active</span></td>
                        </tr>
                        <tr class="hover:bg-gray-50 transition">
                            <td class="px-6 py-4 text-gray-900">002</td>
                            <td class="px-6 py-4 text-gray-900">Jane Smith</td>
                            <td class="px-6 py-4 text-gray-600">jane@example.com</td>
                            <td class="px-6 py-4 text-gray-600">Python</td>
                            <td class="px-6 py-4"><span class="bg-green-100 text-green-800 px-3 py-1 rounded-full text-xs font-semibold">Active</span></td>
                        </tr>
                        <tr class="hover:bg-gray-50 transition">
                            <td class="px-6 py-4 text-gray-900">003</td>
                            <td class="px-6 py-4 text-gray-900">Mike Johnson</td>
                            <td class="px-6 py-4 text-gray-600">mike@example.com</td>
                            <td class="px-6 py-4 text-gray-600">Data Science</td>
                            <td class="px-6 py-4"><span class="bg-yellow-100 text-yellow-800 px-3 py-1 rounded-full text-xs font-semibold">Pending</span></td>
                        </tr>
                        <tr class="hover:bg-gray-50 transition">
                            <td class="px-6 py-4 text-gray-900">004</td>
                            <td class="px-6 py-4 text-gray-900">Sarah Williams</td>
                            <td class="px-6 py-4 text-gray-600">sarah@example.com</td>
                            <td class="px-6 py-4 text-gray-600">Web Dev</td>
                            <td class="px-6 py-4"><span class="bg-green-100 text-green-800 px-3 py-1 rounded-full text-xs font-semibold">Active</span></td>
                        </tr>
                        <tr class="hover:bg-gray-50 transition">
                            <td class="px-6 py-4 text-gray-900">005</td>
                            <td class="px-6 py-4 text-gray-900">Tom Brown</td>
                            <td class="px-6 py-4 text-gray-600">tom@example.com</td>
                            <td class="px-6 py-4 text-gray-600">Mobile Dev</td>
                            <td class="px-6 py-4"><span class="bg-red-100 text-red-800 px-3 py-1 rounded-full text-xs font-semibold">Inactive</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div>
        <h1 class="text-center text-4xl font-bold mb-0 bg-blue-500 text-white p-4 w-full">@silver oak university 2026</h1>
    </div>
</body>
</html>
