=----------------------------------------------------------------------------------------------------------------------


* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: black;
    color: #1d2732;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
}

.poster-card {
    width: min(1200px, 100%);
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 24px;
    background: #fbfaf6;
    border: 1px solid #dad4ca;
    border-radius: 28px;
    box-shadow: 0 24px 60px rgba(35, 48, 73, 0.12);
    overflow: hidden;
    animation: cardFade 0.9s ease-out both;
}

.poster-left,
.poster-right {
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.headline {
    font-size: clamp(2.4rem, 5vw, 3rem);
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 0.95;
    color: #1f3044;
    transform: translateY(14px);
    opacity: 0;
    animation: slideUp 0.8s ease-out 0.2s forwards;
}

.subheading {
    width: max-content;
    background: #2c5d92;
    color: #ffffff;
    padding: 10px 18px;
    border-radius: 999px;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    animation: pulseBadge 3s ease-in-out infinite;
}

h1 {
    margin: 0;
    font-size: clamp(3rem, 6vw, 5rem);
    line-height: 0.85;
    color: #332923;
}

.workshop-badge {
    align-self: flex-start;
    background: #c01c1c;
    color: #ffffff;
    padding: 16px 22px;
    border-radius: 22px;
    font-size: 1.05rem;
    font-weight: 800;
    text-transform: uppercase;
    box-shadow: 0 14px 28px rgba(192, 28, 28, 0.22);
}

.dates {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
}

.date-box {
    min-width: 150px;
    border: 1px solid #d3d0c8;
    border-radius: 18px;
    background: #ffffff;
    padding: 14px 18px;
    text-align: center;
    font-weight: 700;
    color: #20354d;
}

.date-separator {
    color: #6e7481;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
}

.features {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px 20px;
    margin-top: 6px;
}

.feature {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 0.95rem;
    line-height: 1.5;
    opacity: 0;
    transform: translateY(10px);
    animation: fadeInItem 0.8s ease-out forwards;
}

.feature:nth-child(1) { animation-delay: 0.20s; }
.feature:nth-child(2) { animation-delay: 0.28s; }
.feature:nth-child(3) { animation-delay: 0.36s; }
.feature:nth-child(4) { animation-delay: 0.44s; }
.feature:nth-child(5) { animation-delay: 0.52s; }
.feature:nth-child(6) { animation-delay: 0.60s; }

.feature-icon {
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #2c5d92;
    color: #ffffff;
    border-radius: 50%;
    font-weight: 800;
}

.detail-list {
    display: grid;
    gap: 8px;
    margin-top: 8px;
    color: #404750;
    font-size: 0.95rem;
}

.bottom-row {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    align-items: center;
}

.instructor {
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #2f3a47;
}

.phone {
    background: #f6f7fa;
    color: #1e3250;
    border-radius: 18px;
    padding: 12px 18px;
    font-weight: 700;
}

.hero-card {
    display: grid;
    gap: 18px;
    border-radius: 30px;
    background: linear-gradient(180deg, #1d4b7f 0%, #214a7f 42%, #eef4fd 100%);
    padding: 26px;
    min-height: 540px;
    position: relative;
    overflow: hidden;
    animation: floatCard 7s ease-in-out infinite;
}

.hero-shape {
    background: radial-gradient(circle at 20% 20%, rgba(255, 255, 255, 0.45), transparent 18%),
                radial-gradient(circle at 80% 18%, rgba(255, 255, 255, 0.18), transparent 16%),
                radial-gradient(circle at 55% 70%, rgba(255, 255, 255, 0.15), transparent 15%),
                linear-gradient(180deg, rgba(255,255,255,0.18), rgba(255,255,255,0.04));
    border-radius: 28px;
    min-height: 100%;
    position: relative;
    animation: shimmer 10s ease-in-out infinite;
}

.fee-box {
    position: absolute;
    right: 24px;
    top: 24px;
    background: #111826;
    color: #ffffff;
    border-radius: 24px;
    padding: 18px 24px;
    text-align: center;
    box-shadow: 0 20px 40px rgba(17, 24, 38, 0.25);
}

.fee-label {
    font-size: 0.95rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.85;
}

.fee-amount {
    margin-top: 8px;
    font-size: 2rem;
    font-weight: 900;
}

.certification {
    background: rgba(255, 255, 255, 0.13);
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 24px;
    padding: 18px;
    color: #ffffff;
    max-width: 100%;
}

.cert-title {
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.certification p {
    margin: 10px 0 0;
    font-size: 0.95rem;
    line-height: 1.6;
    opacity: 0.92;
}

.action-bar {
    background: #1f334d;
    color: #ffffff;
    padding: 16px 20px;
    border-radius: 999px;
    text-align: center;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.action-note {
    background: #ffffff;
    color: #1f3044;
    padding: 18px 22px;
    border-radius: 24px;
    text-align: center;
    font-weight: 800;
    box-shadow: 0 16px 32px rgba(42, 64, 103, 0.12);
}

@keyframes cardFade {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: translateY(0); }
}

@keyframes slideUp {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: translateY(0); }
}

@keyframes pulseBadge {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.04); }
}

@keyframes floatCard {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
}

@keyframes shimmer {
    0%, 100% { background-position: 0% 0%; }
    50% { background-position: 100% 100%; }
}

@keyframes fadeInItem {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
}

@media (max-width: 980px) {
    .poster-card {
        grid-template-columns: 1fr;
    }

    .hero-card {
        min-height: 420px;
    }
}

@media (max-width: 700px) {
    .poster-left,
    .poster-right {
        padding: 20px;
    }

    .headline {
        font-size: 2.1rem;
    }

    h1 {
        font-size: 3.4rem;
    }

    .features {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 520px) {
    body {
        padding: 14px;
    }

    .poster-card {
        border-radius: 22px;
    }

    .workshop-badge,
    .date-box,
    .phone,
    .action-bar,
    .action-note {
        font-size: 0.95rem;
    }
}
